
import Foundation

//  pyramid pattern n = 4
//       1
//      121
//     12321
//    1234321


func pyramidPattern(_ n: Int) {
    let mid = (2 * n - 1) / 2
// Mid for conditioning value
    for i in 0..<n {   // Number of rows
        var number = 1

        for j in 0..<2*n-1{  // number of colums
            
            if j >= mid-i && j <= mid+i{  // if true
                print(number,terminator: "") // print number
                if j >= mid {
                    number = number - 1   // if mid value reached then number --
                }else{
                    number = number + 1  // if not number increases
                }
            }else{
                print( " ",terminator: "")  // if numbers are not printed then spaces are printed
            }
            
        }
        print()   // for ending each row
    }
}




print("Enter The Number")

guard let n = Int(readLine() ?? "0") else {
    print("Invalid Number")
    exit(0)
}


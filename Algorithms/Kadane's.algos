
import Foundation


class solution {
    func subArraySum(_ nums: [Int])-> Int{
        var maxSum: Int = 0
        var sum = 0

       for i in 0..<nums.count {
           sum += nums[i]
           maxSum = max(maxSum, sum)
           if sum < 0 {
               sum = 0
           }
        }
        return maxSum
    }
}

let s = solution()

var arr: [Int] = []

if let line = readLine() {
    arr = line.split(separator: ",").compactMap{ Int($0)}
}

print(s.subArraySum(arr))

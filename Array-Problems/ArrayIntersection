import Foundation


func commonArray(_ a1:[Int],_ a2:[Int])->[Int]{
    
    var commonArray = [Int]()
    
    for i in 0..<a1.count{
        for j in 0..<a2.count{
            if a1[i] == a2[j]{
                commonArray.append(a1[i])
            }
        }
    }
  
    return commonArray
}



print("Enter the values of Array 1:")


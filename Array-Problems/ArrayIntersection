var array2: [Int] = []



if let line = readLine() {
    array1 = line
        .split(separator: " ")
        .compactMap { Int($0) }   // convert pieces into Int
}

print("Enter the values of Array 2 : ")

if let line = readLine() {
    array2 = line
        .split(separator: " ")
        .compactMap { Int($0) }
}

print(commonArray(array1,array2))


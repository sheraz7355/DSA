import Foundation


func reverseArray(_ n:[Int])-> [Int]{
    
    var reversedArray : [Int] = n
    
    var startIndex = 0
    var endIndex = n.indices.last!
    
    while startIndex < endIndex {
        reversedArray.swapAt(startIndex, endIndex)
        startIndex += 1
        endIndex -= 1
    }
    
    return reversedArray
    
}



print("Enter the values")

var number: [Int] = []

if let line = readLine() {
    number = line
        .split(separator: " ")
        .compactMap { Int($0) }   // convert pieces into Int
}


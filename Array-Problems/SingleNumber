import Foundation


class solution {
    func singleNumber(_ nums: [Int]) -> Int {
        var result: Int = 0
        for num in nums {
            result ^= num
        }
        return result
    }
}

let s = solution()

var arr: [Int] = []

if let line = readLine() {
    arr = line.split(separator: ",").compactMap{ Int($0)}
}

print(s.singleNumber(arr))

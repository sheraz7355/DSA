
import Foundation


class solution {
    func pairSum(_ array: [Int])-> Int{
        var maxCount = 0
        var maxValue: Int = 0
        for i in 0..<array.count {
            var count = 0
          for j in 0..<array.count {
                if array[i] == array[j] {
                  count += 1
              }else {
                    count -= 1
                }
              
              if count > maxCount {
                  maxCount = count
                  maxValue = array[i]
              }
            }
        }
        return maxValue
   }
}

print("Enter the array")
var array: [Int] = []

if let line = readLine() {
    array = line
        .split(separator: " ")
        .compactMap { Int($0) }
}



let s = solution()


print(s.pairSum(array))


import Foundation


class solution {
    func subArraySum(_ nums: [Int])-> Int{
        var maxSum: Int = 0
       for i in 0..<nums.count {
           var sum = 0
           for j in i..<nums.count {
               
                   sum += nums[j]
                   if sum>maxSum{
                       maxSum = sum
                   }
           }
        }
        return maxSum
    }
}

let s = solution()

var arr: [Int] = []

if let line = readLine() {
    arr = line.split(separator: ",").compactMap{ Int($0)}
}

print(s.subArraySum(arr))

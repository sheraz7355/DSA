
import Foundation


func sum(_ n:[Int]){
    
    var sum = 0
    
    for i in n.indices {
        sum += n[i]
    }
    print(sum)
  
}
func product(_ n:[Int]){
    
    var product = 1
    
    for i in n.indices{
        product *= n[i]
    }
    print(product)
    
}


print("Enter the values")

var number : [Int] = []
while let n = readLine() ,let input = Int(n), input != -1 {
    number.append(input)
}
print(sum(number))
print(product(number))

import Foundation

// To find area of square
// Formula area = L x L

func areaSquare(length: Double) -> Double {
    return length * length
}

// To find area of rectangle
// Formula area = L x B

func areaRectangle(length: Double, breadth: Double) -> Double {
    return length * breadth
}

// To fin area of Circle
// Formula area = pie x r^2

func areaCircle(raduis:Double)->Double{
    return Double.pi * raduis * raduis
}

print("Enter the length of square")
let sideLength: Double = Double(readLine() ?? "0")!
print("Area of square is: \(areaSquare(length: sideLength))")


print("Enter the length of rectangle")
let length: Double = Double(readLine() ?? "0")!
print("Enter the breadth of rectangle")
let breadth: Double = Double(readLine() ?? "0")!
print(
    "Area of rectangle is: \(areaRectangle(length: length, breadth: breadth))"
)


print("Enter the raduis of circle")
let raduis: Double = Double(readLine() ?? "0")!
print("Area of circle is: \(areaCircle(raduis: raduis))")


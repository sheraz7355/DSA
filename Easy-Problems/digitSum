
import Foundation


func digitSum(_ n:Int){
    
    if n<1{
        print("Invalid Number")
        return
    }
    var number = n
    var remainder  = 0
    var ans = 0
    while number>0{
        remainder = number%10
        ans = ans + remainder
        number = number/10
    }
    print(ans)
}


print("Enter the value of n")
var n:Int = Int(readLine() ?? "0")!
print(digitSum(n))

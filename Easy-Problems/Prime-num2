import Foundation

func checkPrime(_ n: Int) -> Bool {
    let number = Int(sqrt(Double(n)))
    if n < 2 {
        return false
    }
    for i in 2...number{
        if n % i == 0{
            return false
        }
    }
   return true
}

print("Enter the number")
let n = Int(readLine() ?? "0")!
if(checkPrime(n)){
    print("\(n) is a prime number")
}else {
    print("\(n) is not a prime number")
}


import Foundation


func reverseNumber(_ n:Int){
    
    if n<1{
        print(0)
        return
    }
    
    var number = n
    
    var reverse = 0
    while number>0{
        let remainder = number % 10
        
        reverse  = reverse * 10
        reverse = reverse + remainder
        number = number/10
    }
    print(reverse)
}


print("Enter the value of n")
var n:Int = Int(readLine() ?? "0")!
print(reverseNumber(n))

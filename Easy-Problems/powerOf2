
import Foundation


func powerOf2(_ n:Int){
    
    if n<1{
        print(0)
        return
    }
    
    var pow : Int = 1
    while pow != n{
        pow *= 2
        if pow > n{
            break
        }
    }
    if pow == n {
        print("Yes it is a power of 2")
    }
}


print("Enter the value of n")
var n:Int = Int(readLine() ?? "0")!
print(powerOf2(n))

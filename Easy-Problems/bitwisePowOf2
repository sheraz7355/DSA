import Foundation


func powerOf2(_ n:Int){
    
    if n<1{
        print(0)
        return
    }
    if (n & (n-1)) == 0 {
        print("Yes it is a power of 2")
    }else{
        print("Not power of 2")
    }
}


print("Enter the value of n")
var n:Int = Int(readLine() ?? "0")!
print(powerOf2(n))

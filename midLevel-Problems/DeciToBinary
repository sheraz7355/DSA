
import Foundation


func deciToBinary(_ n:Int){
    
    if n<1{
        print("Invalid Number")
        return
    }
    var number = n
    var remainder  = 0
    var ans = 0
    var pow = 1
    while number>0{
        remainder = number%2
        
        ans = ans + remainder*pow
        number = number/2
        pow = pow*10
    }
    print(ans)
}


print("Enter the value of n")
var n:Int = Int(readLine() ?? "0")!
print(deciToBinary(n))

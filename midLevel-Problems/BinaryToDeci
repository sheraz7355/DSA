
import Foundation


func binaryToDeci(_ n:Int){
    
    if n<1{
        print("Invalid Number")
        return
    }
    var number = n
    var remainder  = 0
    var ans = 0
    var pow = 1
    while number>0{
        remainder = number%10
        
        ans = ans + remainder*pow
        number = number/10
        pow = pow*2
    }
    print(ans)
}


print("Enter the value of n")
var n:Int = Int(readLine() ?? "0")!
print(binaryToDeci(n))
